<% layout("layouts/boilerplate") %>

<style>
    .auth-container {
        margin-top: 4rem;
        margin-bottom: 4rem;
    }
    .auth-card {
        background: #fff;
        border-radius: 1.5rem;
        padding: 3rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        border: 1px solid #eee;
    }
    .form-label {
        font-weight: 600;
        color: #333;
    }
    .form-control {
        border-radius: 10px;
        padding: 0.6rem 1rem;
        border: 1px solid #ccc;
    }
    .form-control:focus {
        border-color: #fe424d;
        box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
    }
    .btn-auth {
        background-color: #fe424d;
        color: white;
        font-weight: 600;
        border-radius: 20px;
        padding: 0.6rem 2rem;
        border: none;
        transition: background-color 0.2s ease;
        width: 100%;
    }
    .btn-auth:hover {
        background-color: #e0303b;
        color: white;
    }
</style>

<body>
    <div class="row auth-container">
        <div class="col-lg-4 offset-lg-4 col-md-6 offset-md-3 col-sm-8 offset-sm-2">
            <div class="auth-card">
                <h2 class="text-center fw-bold mb-4 text-dark"><i class="fa-solid fa-user-plus text-danger me-2"></i>SignUp</h2>
                
                <form method="post" action="/signup" novalidate class="needs-validation">
                    <!-- Username -->
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-user"></i></span>
                            <input name="username" id="username" placeholder="Username" type="text" class="form-control" required>
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please choose a unique username.</div>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                            <input name="email" id="email" placeholder="email@example.com" type="email" class="form-control" required>
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a valid email.</div>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                            <input name="password" id="password" placeholder="Password" type="password" class="form-control" required>
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please choose a password.</div>
                    </div>

                    <button class="btn btn-auth shadow-sm mt-3">SignUp</button>
                </form>
                
                <div class="text-center mt-4">
                    <p class="text-muted small m-0">Already have an account? <a href="/login" class="text-danger fw-bold">Log In</a></p>
                </div>
            </div>
        </div>
    </div>
</body>