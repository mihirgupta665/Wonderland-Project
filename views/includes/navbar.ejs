<style>
    .navbar {
        min-height: 5rem;
        background-color: #fff !important;
        box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    .navbar-brand {
        color: #fe424d !important;
        font-size: 2.2rem;
        font-weight: 800;
        display: flex;
        align-items: center;
    }
    .navbar-brand i {
        font-size: 2.4rem;
        margin-right: 0.5rem;
    }
    .nav-link {
        font-size: 1rem;
        font-weight: 500;
        color: #222 !important;
    }
    .nav-link:hover {
        color: #fe424d !important;
    }
    .input-search {
        border-radius: 20px;
        padding: 0.5rem 1.5rem;
        font-size: 0.9rem;
        min-width: 250px;
        border: 1px solid #ddd;
        transition: all 0.2s ease;
    }
    .input-search:focus {
        border-color: #fe424d;
        box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
    }
    .btn-search {
        background-color: #fe424d;
        color: white !important;
        border-radius: 20px;
        padding: 0.5rem 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        transition: background-color 0.2s ease;
    }
    .btn-search:hover {
        background-color: #e0303b;
    }

    @media (max-width: 767.98px) {
        .navbar-collapse {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .navbar-nav {
            align-items: stretch !important;
            gap: 0.75rem;
        }
        .navbar-nav .nav-link:not(.btn) {
            padding: 0.75rem 0.5rem !important;
            border-bottom: 1px solid #f0f0f0;
        }
        .navbar-nav .btn {
            margin-top: 0.25rem;
            text-align: center;
            width: 100%;
            justify-content: center;
            padding: 0.6rem 1.25rem;
            font-weight: 600;
        }
        .input-search {
            min-width: unset;
            width: 100%;
        }
        .navbar-nav form {
            width: 100%;
        }
    }
</style>

<nav class="navbar navbar-expand-md navbar-light bg-body-light border-bottom sticky-top">
    <div class="container-fluid px-md-5">
        <a class="navbar-brand" href="/listings">
            <i class="fa-solid fa-earth-africa"></i>
            <span class="d-none d-sm-inline" style="font-size: 1.6rem; letter-spacing: -0.5px;">wonderland</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="/listings"><i class="fa-solid fa-compass me-1"></i>Explore</a>
                <a class="nav-link" href="/listings/new"><i class="fa-solid fa-circle-plus me-1"></i>List Property</a>
            </div>
            
            <!-- Working Search Bar -->
            <div class="navbar-nav mx-auto my-2 my-md-0">
                <form class="d-flex" action="/listings" method="GET">
                    <input class="form-control me-2 input-search" type="search" name="location" 
                           placeholder="Search destinations..." 
                           value="<%= (typeof filters !== 'undefined' && filters.location) ? filters.location : '' %>">
                    <button class="btn btn-search d-flex align-items-center justify-content-center" type="submit" style="min-width: 45px;">
                        <i class="fa-solid fa-magnifying-glass"></i><span class="d-none d-md-inline ms-2">Search</span>
                    </button>
                </form>
            </div>
            
            <div class="navbar-nav ms-auto align-items-md-center">
                <% if(currUser) { %>
                    <a class="nav-link me-md-3" href="/listings/favorites">
                        <i class="fa-solid fa-heart text-danger me-1"></i>Favorites
                    </a>
                    <span class="nav-link disabled me-md-3 d-none d-lg-inline">
                        <i class="fa-solid fa-user me-1 text-muted"></i><%= currUser.username %>
                    </span>
                    <a class="btn btn-outline-secondary px-3 py-1 text-dark" href="/logout">LogOut</a>
                <% } else { %>
                    <a class="nav-link me-md-2 fw-bold text-dark" href="/signup">SignUp</a>
                    <a class="btn btn-danger text-white px-3 py-1" href="/login">LogIn</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>