# MongoDB Atlas Database URL
ATLAS_DBURL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wonderland_db?retryWrites=true&w=majority

# Express Session Crypto Secret
SECRET=your_session_secret_key_here

# Mapbox Public Access Token
MAP_TOKEN=pk.your_mapbox_public_access_token_here

# Cloudinary Credentials
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Node Environment (development or production)
NODE_ENV=development
